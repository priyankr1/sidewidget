{
  "headers": [
    {
      "source": "/react-widget-uv.iife.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/react-widget-uv.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/widget-embed.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    },
    {
      "source": "/copilot.html",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://admin.shopify.com" }
      ]
    },
    {
      "source": "/copilot.html",
      "has": [
        { "type": "query", "key": "shop", "value": "(?<shop>[a-z0-9][a-z0-9-]*\\.myshopify\\.com)" }
      ],
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://:shop https://admin.shopify.com" }
      ]
    },
    {
      "source": "/copilot-voice.html",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
